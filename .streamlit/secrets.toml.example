# RailGaadi Train Status API Configuration Template
# Copy this file to .streamlit/secrets.toml and fill in your real API credentials.
# Do NOT commit secrets.toml to version control.

# Required: URL with {train} placeholder for the train number/name
TRAIN_API_URL = "https://example-train-api.com/api/v1/trains/{train}/live-status"

# Required: Your API key / token
TRAIN_API_KEY = "YOUR_API_KEY_HERE"

# Optional: HTTP header name for the API key (defaults to 'X-RapidAPI-Key' or 'Authorization' if omitted)
TRAIN_API_KEY_HEADER = "X-RapidAPI-Key"

# Optional: API Host header (e.g. for RapidAPI endpoints like 'irctc1.p.rapidapi.com')
TRAIN_API_HOST = "example-train-api.p.rapidapi.com"
